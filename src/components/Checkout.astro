---
const commerceOrigin = import.meta.env.PUBLIC_COMMERCE_ORIGIN || "";
const paymentProvider = import.meta.env.PUBLIC_PAYMENT_PROVIDER || "stripe";
---
<div class="selectrow"><label for="destination">Deliver to</label><select id="destination"><option value="6">European Union · €6</option><option value="10">United Kingdom · €10</option><option value="22">Rest of world · €22</option></select></div><p id="order-total" aria-live="polite">Preview total: €44.00</p><button class="btn" id="checkout-preview" type="button">Preview your order →</button><dialog id="order-dialog"><button class="close" autofocus aria-label="Close order preview">×</button><p class="eyebrow">Your little space to bloom</p><h2>Your order preview</h2><p id="order-summary"></p><p>This preview uses test checkout when connected.</p><button class="btn" id="test-checkout" type="button" data-commerce-origin={commerceOrigin} data-provider={paymentProvider} hidden={!commerceOrigin}>Continue to {paymentProvider === "paypal" ? "PayPal" : "Stripe"} test checkout</button><p id="checkout-error" role="alert"></p><button class="btn close">Continue exploring</button></dialog><p class="payment-note">Postage estimates are shown for one journal.</p><div class="note-box">€38 per journal, with no additional IVA added in this preview. Tax treatment and delivery arrangements will be verified before checkout is activated.</div>
<script>
const destination = document.querySelector('#destination');
const dialog = document.querySelector('#order-dialog');
function update(){const shipping=Number(destination.value); document.querySelector('#order-total').textContent=`Preview total: €${(38+shipping).toFixed(2)}`;document.querySelector('#order-summary').textContent=`1 × I Will Bloom journal · €38.00 + estimated delivery €${shipping.toFixed(2)}. Total €${(38+shipping).toFixed(2)}.`;}
destination.addEventListener('change',update);document.querySelector('#checkout-preview').addEventListener('click',()=>{update();dialog.showModal()});document.querySelectorAll('.close').forEach(b=>b.addEventListener('click',()=>dialog.close()));update();
const testCheckout = document.querySelector('#test-checkout');
let requestKey = null, requestFingerprint = '';
testCheckout?.addEventListener('click', async () => {
 const error = document.querySelector('#checkout-error');
 const endpoint = testCheckout.dataset.commerceOrigin;
 const input = { quantity: 1, region: ({'6':'eu','10':'uk','22':'rest'})[destination.value] };
 const fingerprint = JSON.stringify(input);
 if (fingerprint !== requestFingerprint) { requestKey = crypto.randomUUID(); requestFingerprint = fingerprint; }
 error.textContent = ''; testCheckout.disabled = true;
 try {
  const origin = new URL(endpoint); if(origin.protocol !== 'https:') throw new Error('Secure test checkout is not configured.');
  const response = await fetch(new URL('/api/checkout',origin),{method:'POST',headers:{'Content-Type':'application/json','Idempotency-Key':requestKey},body:fingerprint});
  const result = await response.json(); if(!response.ok) throw new Error(result.error || 'Checkout is temporarily unavailable.');
  const url = new URL(result.url); if(url.protocol !== 'https:' || !(testCheckout.dataset.provider === 'paypal' ? ['www.sandbox.paypal.com'] : ['checkout.stripe.com']).includes(url.hostname)) throw new Error('Unable to open secure checkout.');
  window.location.assign(url.href);
 } catch(e) { error.textContent=e.message || 'Please try again.'; testCheckout.disabled=false; }
});
</script>
<style>
.selectrow{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
dialog{width:min(480px,calc(100% - 32px));max-height:85dvh;border:1px solid #b4b9a3;padding:32px;background:#fbf9f3;color:#31392f}
dialog::backdrop{background:#26302599}
dialog > button:first-child{float:right;border:0;background:transparent;font-size:25px}
dialog button[hidden]{display:none}
dialog p{line-height:1.6}
</style>
