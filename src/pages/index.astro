    h1,h2,h3,.quote{letter-spacing:-.025em}

[hidden]{display:none!important}

    :root{--sage:#b4b9a3;--deep:#47513e;--cream:#faf6ee;--ink:#31392f;--gold:#aa8e60;--muted:#747b70;--line:#e8dfd1}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'Red Hat Display',sans-serif}a{color:inherit}button{font:inherit;cursor:pointer} .ribbon{background:#66725c;color:#fff;text-align:center;padding:10px 15px;font-size:12px;letter-spacing:.09em}header{position:sticky;top:0;z-index:10;background:rgba(250,246,238,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.nav{max-width:1220px;margin:auto;min-height:80px;padding:12px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{display:flex;align-items:center;gap:11px;text-decoration:none;font-family:Forum,serif;font-size:27px;letter-spacing:.09em;white-space:nowrap}.lotus{color:var(--gold);font-size:30px}.navlinks{display:flex;gap:28px;align-items:center}.navlinks a{text-decoration:none;font-size:13px}.btn{display:inline-flex;justify-content:center;align-items:center;gap:10px;background:var(--deep);color:white;border:1px solid var(--deep);padding:15px 23px;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;transition:.2s}.btn:hover{background:#61705a}.btn.ghost{background:transparent;color:var(--deep)}.btn.ghost:hover{background:#edf0e8}.container{max-width:1180px;margin:auto;padding:0 28px}.hero{background:linear-gradient(115deg,#fbf9f3 0%,#fbf9f3 49%,#e4e8dc 49%,#e9ede2 100%);overflow:hidden}.hero-inner{min-height:665px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:50px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7c856f}.hero h1,h2,.quote{font-family:Forum,serif;font-weight:400}.hero h1{font-size:clamp(48px,5.4vw,78px);line-height:1.05;margin:22px 0}.hero h1 em{color:#8b987d;font-weight:normal}.hero p{max-width:490px;font-size:16px;line-height:1.9;color:#596257}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 24px}.smallnote{font-size:12px;color:#6c756a}.art{min-height:580px;display:flex;align-items:center;justify-content:center;position:relative}.halo{position:absolute;width:480px;height:480px;border-radius:50%;background:#d4ddc7;filter:blur(1px)}.leaf{position:absolute;font-size:160px;opacity:.14;color:#5b7057;transform:rotate(-25deg);left:-20px;top:55px}.journal{position:relative;width:315px;height:430px;background:linear-gradient(145deg,#a9b19b,#899680);border-radius:3px 12px 12px 3px;box-shadow:25px 25px 40px #3f4c4038,-6px 3px 1px #f4eee0;border:1px solid #899580;transform:rotate(-8deg);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#f8f4e8;text-align:center}.spiral{position:absolute;left:-10px;top:15px;bottom:15px;display:flex;flex-direction:column;justify-content:space-around}.spiral span{width:22px;height:8px;border:2px solid #e5e5dc;border-radius:10px;background:transparent}.journal .symbol{font-size:71px;color:#f2e5c3;margin-bottom:10px}.journal .brand{font-family:Forum,serif;font-size:37px;letter-spacing:.09em;line-height:1.2}.journal .sub{font-size:11px;letter-spacing:.18em;margin-top:24px}.overlay{position:absolute;bottom:62px;right:0;background:#fffdf8;padding:17px 22px;box-shadow:0 10px 35px #5e6b5926;font-family:Forum,serif;font-size:21px;transform:rotate(5deg)}.trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fffdf8}.trustinner{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;text-align:center;padding:27px}.trustinner div{font-size:12px;letter-spacing:.07em}.trustinner span{color:var(--gold);font-size:19px;margin-right:8px}.section{padding:100px 0}.center{text-align:center}.section h2{font-size:clamp(37px,4vw,55px);line-height:1.14;margin:12px 0 22px}.intro{font-size:16px;line-height:1.9;color:#687265;max-width:660px;margin:auto}.featuregrid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}.feature{background:#fff;border:1px solid var(--line);padding:38px 32px;min-height:240px}.feature .num{font-family:Forum,serif;font-size:34px;color:var(--gold)}.feature h3{font-family:Forum,serif;font-weight:normal;font-size:28px;margin:16px 0 10px}.feature p{font-size:14px;line-height:1.8;color:#687265}.split{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.panel{background:#e6e9db;padding:68px 58px;min-height:480px;display:flex;flex-direction:column;justify-content:center}.panel .quote{font-size:42px;line-height:1.23}.copy p{line-height:1.9;color:#687265}.copy h2{margin-top:12px}.bullets{padding-left:18px;line-height:2.2;color:#586452}.product{background:#f0f1e9}.purchase{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.mini{min-height:440px;display:flex;align-items:center;justify-content:center;background:#e2e6d7}.mini .journal{transform:rotate(-5deg) scale(.78)}.price{font-family:Forum,serif;font-size:42px;margin:24px 0 15px}.selectrow{display:flex;gap:13px;align-items:center;margin-bottom:22px}.selectrow label{font-size:13px;font-weight:700}.selectrow select{padding:12px 16px;background:white;border:1px solid #c8cebd}.payment-note{font-size:12px;color:#6b7469;line-height:1.7}.checkout-disabled{opacity:.65;cursor:not-allowed}.stories{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:45px}.story{padding:30px;background:#fff;border:1px solid var(--line);text-decoration:none}.story small{letter-spacing:.14em;color:#8c927f}.story h3{font-family:Forum,serif;font-weight:normal;font-size:27px;line-height:1.2}.story p{font-size:13px;color:#6c756a;line-height:1.8}.newsletter{background:#65735f;color:white;text-align:center;padding:75px 25px}.newsletter h2{font-size:48px;margin:8px 0}.newsletter p{max-width:540px;margin:0 auto 28px;line-height:1.8}.newsletter .btn{background:#fffdf8;color:var(--deep);border-color:#fffdf8}footer{padding:50px 0;background:#fbf9f3;border-top:1px solid var(--line)}footer .foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}footer small{color:#858d7f}footer a{font-size:13px;text-decoration:none;margin-left:18px}.dev{background:#fff2d9;border-bottom:1px solid #e2ca93;color:#5e4c24;font-size:12px;text-align:center;padding:9px 15px}.note-box{background:#f9f4e7;padding:16px 18px;border-left:3px solid var(--gold);margin-top:18px;font-size:12px;line-height:1.7;color:#73694d}@media(max-width:850px){.nav{min-height:68px}.navlinks{display:none}.hero{background:linear-gradient(#fbf9f3 0 49%,#e9ede2 49%)}.hero-inner,.split,.purchase{grid-template-columns:1fr;gap:25px}.hero-inner{padding-top:55px}.hero h1{font-size:53px}.art{min-height:460px}.halo{width:345px;height:345px}.journal{transform:rotate(-8deg) scale(.76)}.overlay{bottom:30px;right:20px}.featuregrid,.stories{grid-template-columns:1fr}.section{padding:65px 0}.trustinner{grid-template-columns:1fr;gap:12px}.panel{min-height:350px;padding:40px}.panel .quote{font-size:36px}.purchase{gap:35px}.mini{min-height:350px}.newsletter h2{font-size:38px}}@media(max-width:450px){.container{padding:0 20px}.logo{font-size:21px}.btn{padding:13px 16px}.hero h1{font-size:44px}.hero-inner{gap:0}.art{min-height:420px}.overlay{font-size:16px}.hero p{font-size:14px}}
  
.skip{position:absolute;top:-100px}.skip:focus{top:10px;left:10px;z-index:99;background:white;padding:12px}a:focus-visible,button:focus-visible,summary:focus-visible,select:focus-visible{outline:3px solid #83632f;outline-offset:4px}section{scroll-margin-top:100px}.hero{background:#f7f5ed}.hero-inner{gap:64px;min-height:680px}.hero-photo{margin:34px 0;position:relative;align-self:stretch;display:flex;flex-direction:column;justify-content:center}.hero-photo img{width:100%;height:550px;object-fit:cover;border-radius:48% 48% 2px 2px}.hero-photo figcaption{font-size:10px;color:#5b6358;margin-top:10px;text-align:center}.photo-note{position:absolute;bottom:55px;left:-35px;background:#fcfaf2;padding:20px 30px;box-shadow:0 8px 30px #3332;font-family:Forum,Georgia,serif;font-size:28px;transform:rotate(-5deg)}.hero h1{font-size:clamp(48px,5.1vw,74px)}.eyebrow{color:#59634e}.letter{padding:30px 28px 60px;font-family:Forum,Georgia,serif;font-size:28px;max-width:850px;text-align:center}.letter .eyebrow{font-family:Arial,sans-serif}.feature{text-align:left;background:transparent;border:0;border-top:1px solid #c8cbbd}.faq{max-width:850px}details{border-bottom:1px solid #c8cbbd;padding:22px 0}summary{cursor:pointer;font-size:18px}details p{line-height:1.8;color:#586452}dialog{border:1px solid #c8cbbd;background:#fbf9f3;color:#31392f;padding:40px;max-width:520px;width:calc(100% - 32px)}dialog::backdrop{background:#26322599}dialog h2{font-family:Forum,Georgia,serif;font-size:38px}dialog p{line-height:1.8}dialog>button:first-child{float:right;background:none;border:0;font-size:28px}.navlinks a:hover{text-decoration:underline;text-underline-offset:6px}@media(max-width:850px){.hero-inner{gap:15px}.hero-photo{margin:20px 0 35px}.hero-photo img{height:460px}.photo-note{left:0;bottom:45px}.nav{padding:12px 20px}.hero{background:#f7f5ed}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
.mobile-nav{display:none}.mobile-nav a{display:block;padding:10px}.mobile-nav summary{cursor:pointer}.mobile-nav[open] nav{position:absolute;right:16px;padding:20px;background:#fbf9f3;box-shadow:0 6px 25px #0002;width:220px}@media(max-width:850px){.nav>.btn{display:none}.mobile-nav{display:block}}
.brand-lotus{width:45px;height:36px;object-fit:contain;flex-shrink:0}.hero-photo img{object-position:center 47%;border-radius:46% 46% 3px 3px}.product-photo{margin:0;background:#e3e6da;padding:24px;display:grid;place-items:center}.product-photo img{width:100%;max-height:560px;object-fit:contain;height:auto}.product-link{font-size:14px;text-underline-offset:5px}.reader-note{background:#e9ecdf;text-align:center}.reader-note blockquote{max-width:780px;margin:20px auto 0}.reader-note blockquote p{font:400 clamp(27px,3vw,40px)/1.35 Forum,Georgia,serif}.reader-note blockquote footer{padding:0;background:none;border:0;font:14px/1.6 'Red Hat Display',sans-serif;color:#596257}@media(max-width:450px){.hero-photo img{height:440px}.brand-lotus{width:32px;height:26px}.product-photo{padding:16px}}.founder-photo{margin:0}.founder-photo img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}.founder-photo figcaption{font-size:.85rem;margin-top:.7rem;color:#596257}
.hero{background:#f7efe3}
.hero-photo img{border-radius:48% 48% 1.25rem 1.25rem}
.hero h1 em{color:#59674f}
#story{background:#f4ebdd}
.founder-photo img{border-radius:1.25rem}

.hero-inner{grid-template-columns:minmax(0,1fr) minmax(0,1.06fr);gap:clamp(2rem,6vw,6rem);padding-block:clamp(2.5rem,6vw,5.5rem);min-height:0}
.hero-photo{margin:0}
.hero-photo img{height:auto;aspect-ratio:4/5;object-position:center 46%}
.hero p{max-width:42ch}
.text-link{text-underline-offset:.25em;font-weight:700}
.actions{align-items:center;column-gap:1.5rem}
.inside-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(1.5rem,7vw,7rem)}
.inside-layout dl{margin:0}
.inside-layout dl div{border-top:1px solid var(--line);padding:1rem 0}
.inside-layout dt{font:400 1.65rem Forum,serif}
.inside-layout dd{margin:.35rem 0 0;line-height:1.65;color:#596257}
#library .stories{grid-template-columns:1fr;gap:0;max-width:680px;margin-inline:auto;text-align:left}
#library .story{background:transparent;border:0;border-top:1px solid var(--line);padding:1rem 0}
#library .story h3{margin:0;text-decoration:underline;text-underline-offset:.18em}
#library .story p{margin:.35rem 0 0}
@media(max-width:850px){.hero-inner,.inside-layout{grid-template-columns:1fr}.hero-photo img{max-height:510px}}
</style>
